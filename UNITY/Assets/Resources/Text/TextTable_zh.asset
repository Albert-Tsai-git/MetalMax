  - key: SHP_Zhanqiao.name
    text: "\u6808\u6865\u9547\u5546\u5E97"
  - key: UI.Result.Ok
    text: "\u64CD\u4F5C\u5B8C\u6210\u3002"
  - key: UI.Result.NotEnoughGold
    text: "\u91D1\u94B1\u4E0D\u8DB3\u3002"
  - key: UI.Result.NotInShop
    text: "\u8FD9\u5BB6\u5546\u5E97\u6CA1\u6709\u51FA\u552E\u8BE5\u90E8\u4EF6\u3002"
  - key: UI.Result.NotInInventory
    text: "\u80CC\u5305\u91CC\u6CA1\u6709\u8FD9\u4E2A\u90E8\u4EF6\u3002"
  - key: UI.Result.NoChassis
    text: "\u9700\u8981\u5148\u5B89\u88C5\u53EF\u7528\u7684\u5E95\u76D8\u548C\u5F15\u64CE\u3002"
  - key: UI.Result.HoleNotFound
    text: "\u627E\u4E0D\u5230\u5BF9\u5E94\u7684\u6B66\u5668\u6302\u4F4D\u3002"
  - key: UI.Result.HoleTypeMismatch
    text: "\u6B66\u5668\u7C7B\u578B\u4E0E\u6302\u4F4D\u4E0D\u5339\u914D\u3002"
  - key: UI.Result.Overweight
    text: "\u6539\u88C5\u540E\u5C06\u8D85\u8FC7\u8F7D\u91CD\u4E0A\u9650\u3002"
  - key: UI.Result.MaxUpgrade
    text: "\u8BE5\u90E8\u4EF6\u5DF2\u6539\u9020\u5230\u4E0A\u9650\u3002"
  - key: UI.Result.CannotRemove
    text: "\u5E95\u76D8\u548C\u5F15\u64CE\u53EA\u80FD\u66FF\u6362\uFF0C\u4E0D\u80FD\u76F4\u63A5\u5378\u4E0B\u3002"
  - key: UI.Result.SlotEmpty
    text: "\u8FD9\u4E2A\u4F4D\u7F6E\u8FD8\u6CA1\u6709\u90E8\u4EF6\u6216\u5B58\u6863\u3002"
  - key: UI.Result.UnknownPart
    text: "\u65E0\u6CD5\u8BC6\u522B\u8FD9\u4E2A\u90E8\u4EF6\u3002"
  - key: UI.Result.NothingToDo
    text: "\u5F53\u524D\u65E0\u9700\u64CD\u4F5C\u3002"
  - key: UI.Result.SlotNotFound
    text: "\u627E\u4E0D\u5230\u8FD9\u4E2A\u5B58\u6863\u69FD\u4F4D\u3002"
  - key: UI.Result.IoError
    text: "\u5B58\u6863\u8BFB\u5199\u5931\u8D25\uFF0C\u8BF7\u68C0\u67E5\u78C1\u76D8\u7A7A\u95F4\u4E0E\u8BBF\u95EE\u6743\u9650\u3002"
  - key: UI.Result.Corrupted
    text: "\u5B58\u6863\u5DF2\u635F\u574F\uFF0C\u65E0\u6CD5\u8BFB\u53D6\u3002"
  - key: TWN_Zhanqiao.name
    text: "\u6808\u6865\u9547"
  - key: UI.Result.NotFound
    text: "\u627E\u4E0D\u5230\u5BF9\u5E94\u7684\u76EE\u6807\u3002"
  - key: UI.Result.NoBountyOffice
    text: "\u8FD9\u91CC\u6CA1\u6709\u8D4F\u91D1\u529E\u4E8B\u5904\u3002"
  - key: UI.Result.ChoiceRequired
    text: "\u8BF7\u9009\u62E9\u4E00\u4E2A\u9009\u9879\u3002"
  - key: UI.Result.StackFull
    text: "\u80CC\u5305\u5DF2\u7ECF\u88C5\u6EE1\u3002"
  - key: UI.Result.InvalidTarget
    text: "\u65E0\u6CD5\u5BF9\u8FD9\u4E2A\u76EE\u6807\u4F7F\u7528\u3002"
  - key: QST_Act1_Signal.name
    text: "\u6CF5\u7AD9\u7684\u6C42\u6551\u4FE1\u53F7"
  - key: QST_Act1_Signal.step0
    text: "\u524D\u5F80\u5E9F\u5F03\u6CF5\u7AD9\uFF0C\u8C03\u67E5\u65AD\u7EED\u53D1\u51FA\u7684\u6C42\u6551\u4FE1\u53F7\u3002"
  - key: QST_Act1_Signal.step1
    text: "\u51FB\u8D25\u94C1\u94B3\u5DE8\u87F9\uFF0C\u53D6\u56DE\u6CF5\u7AD9\u7EF4\u62A4\u65E5\u5FD7\u3002"
  - key: QST_Act1_Signal.step2
    text: "\u56DE\u5230\u6808\u6865\u9547\uFF0C\u628A\u7EF4\u62A4\u65E5\u5FD7\u4EA4\u7ED9\u66F2\u5A46\u3002"
  - key: SKL_AcidSpit.name
    text: "\u9178\u6DB2\u55B7\u5410"
  - key: SKL_TwinShot.name
    text: "\u53CC\u8FDE\u5C04"
  - key: SKL_Howl.name
    text: "\u8352\u539F\u568E\u53EB"
  - key: SKL_CrabPinch.name
    text: "\u94C1\u94B3\u5939\u51FB"
  - key: SKL_BrineSpray.name
    text: "\u76D0\u6C34\u55B7\u5C04"
  - key: SKL_ShellMend.name
    text: "\u7532\u58F3\u4FEE\u590D"
  - key: ITM_Tonic.name
    text: "\u6062\u590D\u996E\u5242"
  - key: ITM_Tonic.desc
    text: "\u6062\u590D\u4E00\u540D\u540C\u4F34 50 \u70B9 HP\u3002"
  - key: ITM_ReviveKit.name
    text: "\u6025\u6551\u590D\u82CF\u5305"
  - key: ITM_ReviveKit.desc
    text: "\u4F7F\u4E00\u540D\u5012\u4E0B\u7684\u540C\u4F34\u6062\u590D\u884C\u52A8\u80FD\u529B\u3002"
  - key: ITM_RepairPack.name
    text: "\u6218\u8F66\u4FEE\u7406\u5305"
  - key: ITM_RepairPack.desc
    text: "\u4E3A\u4E00\u8F86\u6218\u8F66\u6062\u590D\u81F3\u591A 150 \u70B9 SP\u3002"
  - key: ITM_AmmoCrate.name
    text: "\u901A\u7528\u5F39\u836F\u7BB1"
  - key: ITM_AmmoCrate.desc
    text: "\u8865\u5145\u6218\u8F66\u6B66\u5668\u5F39\u836F\u3002"
  - key: UI.Element.Normal
    text: "\u5B9E\u5F39"
  - key: UI.Element.Fire
    text: "\u706B\u7130"
  - key: UI.Element.Ice
    text: "\u51B7\u51BB"
  - key: UI.Element.Electric
    text: "\u7535\u51FB"
  - key: UI.Element.Sonic
    text: "\u97F3\u6CE2"
  - key: WPN_Flamethrower.name
    text: "\u706B\u7130\u55B7\u5C04\u5668"
  - key: WPN_Flamethrower.desc
    text: "\u5411\u4E00\u7EC4\u654C\u4EBA\u55B7\u5C04\u71C3\u70E7\u5242\uFF1B\u65E0\u9700\u88C5\u586B\u5F39\u836F\u3002"
  - key: WPN_ShockCannon.name
    text: "\u7535\u51FB\u70AE"
  - key: WPN_ShockCannon.desc
    text: "\u4EE5\u7535\u5F27\u6253\u51FB\u5355\u4E2A\u76EE\u6807\uFF0C\u5BF9\u7535\u5C5E\u6027\u5F31\u70B9\u6548\u679C\u663E\u8457\u3002"
  - key: UI.Battle.Repair
    text: "\u4FEE\u7406"
  - key: UI.Portal.PumpLocked
    text: "\u6CF5\u7AD9\u95F8\u95E8\u6CA1\u6709\u54CD\u5E94\u3002\u63A7\u5236\u53F0\u8981\u6C42\u6709\u6548\u7684\u7EF4\u62A4\u6388\u6743\u3002"
  - key: DLG_Act1_Intro.01
    text: "\u6808\u6865\u9547\u2026\u2026\u8FD9\u8F86\u8F66\u603B\u7B97\u80FD\u6B47\u4E00\u53E3\u6C14\u4E86\u3002"
  - key: DLG_Act1_Intro.02
    text: "\u5148\u522B\u677E\u61C8\u3002\u4FEE\u8F66\u94FA\u8FD8\u8BB0\u7740\u8D26\uFF0C\u6211\u4EEC\u5F97\u67E5\u6E05\u90A3\u6BB5\u6CF5\u7AD9\u6C42\u6551\u4FE1\u53F7\u3002"
  - key: DLG_Act1_Intro.03
    text: "\u4FE1\u53F7\u65AD\u65AD\u7EED\u7EED\uFF0C\u65B9\u5411\u5728\u5317\u8FB9\u7684\u65E7\u6CF5\u7AD9\u3002\u5E26\u4E0A\u6EE4\u82AF\uFF0C\u8DEF\u4E0A\u522B\u8BA9\u53D1\u52A8\u673A\u5403\u76D0\u3002"
  - key: DLG_Act1_Report.01
    text: "\u66F2\u5A46\u628A\u7EF4\u62A4\u65E5\u5FD7\u7FFB\u5230\u6700\u540E\u4E00\u9875\uFF0C\u7709\u5934\u8D8A\u76B1\u8D8A\u7D27\u3002"
  - key: DLG_Act1_Report.02
    text: "\u8FD9\u4E0D\u662F\u6C42\u6551\u8BB0\u5F55\u3002\u6CF5\u7F51\u8FD8\u5728\u8FD0\u884C\uFF0C\u5B83\u628A\u6C34\u9001\u53BB\u4E86\u5DF2\u7ECF\u7A7A\u4E86\u51E0\u5341\u5E74\u7684\u5730\u65B9\u3002"
  - key: DLG_Act1_Report.03
    text: "\u90A3\u6CBF\u7EBF\u7684\u4EBA\u5462\uFF1F\u628A\u65E5\u5FD7\u6284\u51E0\u4EFD\u3002\u8C01\u6709\u6C34\u3001\u8C01\u6CA1\u6C34\uFF0C\u4E0D\u80FD\u518D\u7531\u4E00\u53F0\u65E7\u673A\u5668\u66FF\u5927\u5BB6\u51B3\u5B9A\u3002"
  - key: UI.Interact.Open
    text: "\u6253\u5F00"
  - key: UI.Interact.Talk
    text: "\u4EA4\u8C08"
  - key: UI.Interact.Board
    text: "\u4E0A\u8F66"
  - key: NPC_Qupo.name
    text: "\u66F2\u5A46"
  - key: DLG_Qupo.Report.01
    text: "\u4F60\u4EEC\u4ECE\u6CF5\u7AD9\u5E26\u56DE\u4E86\u4EC0\u4E48\uFF1F"
  - key: DLG_Qupo.Report.02
    text: "\u8FD9\u4EFD\u65E5\u5FD7\u8BC1\u660E\u6CF5\u7F51\u4ECD\u5728\u7ED9\u7A7A\u57CE\u9001\u6C34\uFF0C\u6CBF\u7EBF\u805A\u843D\u5374\u88AB\u5224\u6210\u65E0\u4EBA\u5C45\u4F4F\u3002"
  - key: DLG_Qupo.Report.03
    text: "\u6211\u4F1A\u628A\u8BB0\u5F55\u6284\u7ED9\u8DEF\u706F\u8F66\u961F\u3002\u6C34\u7684\u8D26\uFF0C\u5F97\u8BA9\u6BCF\u4E2A\u805A\u843D\u90FD\u770B\u89C1\u3002\u7EF4\u4FEE\u6B20\u8D26\u5148\u8BB0\u5728\u5899\u4E0A\u3002"
  - key: DLG_Qupo.Banter
    text: "\u8F66\u8F6E\u5E26\u56DE\u7684\u76D0\u5148\u522E\u6389\uFF0C\u522B\u8BA9\u5B83\u54AC\u8FDB\u8F74\u627F\u91CC\u3002\u9700\u8981\u4FEE\u7406\u5C31\u8DDF\u6211\u8BF4\u3002"
  - key: UI.Screen.Menu
    text: "\u884C\u65C5\u6863\u6848"
  - key: UI.Screen.WorldMap
    text: "\u8352\u91CE\u5730\u56FE"
