  entries:
  - key: TNK_Chassis_Light.name
    text: "\u8F7B\u578B\u8D8A\u91CE\u5E95\u76D8"
  - key: TNK_Chassis_Light.desc
    text: "\u8F66\u8EAB\u8F7B\u5DE7\uFF0C\u9002\u5408\u7A7F\u884C\u76D0\u58F3\u5730\u548C\u65E7\u516C\u8DEF\u3002\u53EF\u88C5\u4E3B\u70AE\u4E0E\u526F\u70AE\u3002"
  - key: TNK_Chassis_Heavy.name
    text: "\u91CD\u578B\u627F\u8F7D\u5E95\u76D8"
  - key: TNK_Chassis_Heavy.desc
    text: "\u88C5\u7532\u539A\u5B9E\uFF0C\u53EF\u5BB9\u7EB3\u4E3B\u70AE\u3001\u526F\u70AE\u548C\u7279\u6B8A\u6B66\u5668\uFF1B\u8FDC\u884C\u524D\u8BB0\u5F97\u6838\u5BF9\u8F7D\u91CD\u3002"
  - key: TNK_Engine_V8.name
    text: "V8 \u56DE\u6536\u5F15\u64CE"
  - key: TNK_Engine_V12.name
    text: "V12 \u91CD\u8F7D\u5F15\u64CE"
  - key: TNK_CUnit_Basic.name
    text: "\u57FA\u7840 C \u88C5\u7F6E"
  - key: TNK_CUnit_Twin.name
    text: "\u53CC\u6838 C \u88C5\u7F6E"
  - key: TNK_CUnit_Twin.desc
    text: "\u53CC\u6838\u5FC3\u534F\u540C\u5904\u7406\u6307\u4EE4\uFF0C\u4E3A\u6BCF\u56DE\u5408\u7684\u8FFD\u52A0\u884C\u52A8\u63D0\u4F9B\u652F\u6301\u3002"
  - key: WPN_Cannon_75.name
    text: "75 \u6BEB\u7C73\u4E3B\u70AE"
  - key: WPN_MG_77.name
    text: "7.7 \u6BEB\u7C73\u673A\u67AA"
  - key: WPN_SE_Missile.name
    text: "\u53CC\u8054\u88C5\u5BFC\u5F39"
  - key: ENM_Ant.name
    text: "\u76D0\u58F3\u53D8\u5F02\u8681"
  - key: ENM_TurretBug.name
    text: "\u70AE\u53F0\u866B"
  - key: ENM_Dog.name
    text: "\u8352\u539F\u91CE\u72D7"
  - key: ENM_Bounty_IronCrab.name
    text: "\u94C1\u94B3\u5DE8\u87F9"
  - key: CHR_Hunter.name
    text: "\u730E\u4EBA"
  - key: CHR_Mechanic.name
    text: "\u673A\u68B0\u5E08"
  - key: SHP_Zhanqiao.name
    text: "\u6808\u6865\u9547\u5546\u5E97"
  - key: UI.Result.Ok
    text: "\u64CD\u4F5C\u5B8C\u6210\u3002"
  - key: UI.Result.NotEnoughGold
    text: "\u91D1\u94B1\u4E0D\u8DB3\u3002"
  - key: UI.Result.NotInShop
    text: "\u8FD9\u5BB6\u5546\u5E97\u6CA1\u6709\u51FA\u552E\u8BE5\u90E8\u4EF6\u3002"
  - key: UI.Result.NotInInventory
    text: "\u80CC\u5305\u91CC\u6CA1\u6709\u8FD9\u4E2A\u90E8\u4EF6\u3002"
  - key: UI.Result.NoChassis
    text: "\u9700\u8981\u5148\u5B89\u88C5\u53EF\u7528\u7684\u5E95\u76D8\u548C\u5F15\u64CE\u3002"
  - key: UI.Result.HoleNotFound
    text: "\u627E\u4E0D\u5230\u5BF9\u5E94\u7684\u6B66\u5668\u6302\u4F4D\u3002"
  - key: UI.Result.HoleTypeMismatch
    text: "\u6B66\u5668\u7C7B\u578B\u4E0E\u6302\u4F4D\u4E0D\u5339\u914D\u3002"
  - key: UI.Result.Overweight
    text: "\u6539\u88C5\u540E\u5C06\u8D85\u8FC7\u8F7D\u91CD\u4E0A\u9650\u3002"
  - key: UI.Result.MaxUpgrade
    text: "\u8BE5\u90E8\u4EF6\u5DF2\u6539\u9020\u5230\u4E0A\u9650\u3002"
  - key: UI.Result.CannotRemove
    text: "\u5E95\u76D8\u548C\u5F15\u64CE\u53EA\u80FD\u66FF\u6362\uFF0C\u4E0D\u80FD\u76F4\u63A5\u5378\u4E0B\u3002"
  - key: UI.Result.SlotEmpty
    text: "\u8FD9\u4E2A\u4F4D\u7F6E\u8FD8\u6CA1\u6709\u90E8\u4EF6\u6216\u5B58\u6863\u3002"
  - key: UI.Result.UnknownPart
    text: "\u65E0\u6CD5\u8BC6\u522B\u8FD9\u4E2A\u90E8\u4EF6\u3002"
  - key: UI.Result.NothingToDo
    text: "\u5F53\u524D\u65E0\u9700\u64CD\u4F5C\u3002"
  - key: UI.Result.SlotNotFound
    text: "\u627E\u4E0D\u5230\u8FD9\u4E2A\u5B58\u6863\u69FD\u4F4D\u3002"
  - key: UI.Result.IoError
    text: "\u5B58\u6863\u8BFB\u5199\u5931\u8D25\uFF0C\u8BF7\u68C0\u67E5\u78C1\u76D8\u7A7A\u95F4\u4E0E\u8BBF\u95EE\u6743\u9650\u3002"
  - key: UI.Result.Corrupted
    text: "\u5B58\u6863\u5DF2\u635F\u574F\uFF0C\u65E0\u6CD5\u8BFB\u53D6\u3002"
